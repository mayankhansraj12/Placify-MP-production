# Placify AI environment example
# Copy this file to .env for local backend development.
# In production, set these values as Render/Vercel environment variables.

# Required shared secret
PLACIFY_SECRET_KEY=replace-with-python-secrets-token-hex-32

# Backend server
HOST=0.0.0.0
PORT=5000
UVICORN_RELOAD=false
LOG_LEVEL=INFO
SKIP_MODEL_LOAD=false
ENABLE_LOCAL_CORS_REGEX=false

# MongoDB Atlas
MONGODB_URI=
# Example: mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=placify
MONGODB_TIMEOUT_MS=8000

# Frontend/API origin wiring
FRONTEND_URL=http://localhost:5173
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOW_COOKIE_AUTH=false

# Rate limits and metrics
AUTH_RATE_LIMIT_PER_MIN=30
ANALYSIS_RATE_LIMIT_PER_MIN=20
RESUME_ENHANCE_RATE_LIMIT_PER_MIN=10
COACH_RATE_LIMIT_PER_MIN=20
INTERVIEW_RATE_LIMIT_PER_MIN=20
METRICS_ENABLED=false
METRICS_TOKEN=

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5000/api/auth/github/callback

# LLM providers
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=6000
ENABLE_RAG=true

# Production values for placifyai.dev:
# FRONTEND_URL=https://placifyai.dev
# CORS_ALLOW_ORIGINS=https://placifyai.dev,https://www.placifyai.dev
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# GOOGLE_REDIRECT_URI=https://api.placifyai.dev/api/auth/google/callback
# GITHUB_REDIRECT_URI=https://api.placifyai.dev/api/auth/github/callback
#
# Render free backend on *.onrender.com plus Vercel frontend is cross-site:
# COOKIE_SAMESITE=none
#
# Frontend variables belong in client/.env for local frontend overrides,
# or in the Vercel project environment variables for deployment:
# VITE_API_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com/api
